; SilentSDDM config for zhen's T490 — wallpaper palette (A), Inter, layout like hyprlock
; Installed as configs/default.conf.user, which SDDM layers over the theme's default.conf
; https://github.com/uiriansan/SilentSDDM/wiki/Customizing

[General]
scale = 1.0
enable-animations = true
animated-background-placeholder = ""
background-fill-mode = "fill"

[LockScreen]
display = true
padding-top = 0
padding-right = 0
padding-bottom = 0
padding-left = 0
background = "star-chart.png"
use-background-color = false
background-color = "#121318"
blur = 0
brightness = -0.1
saturation = 0.0
input-keystroke = false
ignore-shift-key = false

[LockScreen.Clock]
display = true
position = "center"
align = "center"
format = "HH:mm"
font-family = "Inter"
font-size = 96
font-weight = 700
color = "#e3e1e9"

[LockScreen.Date]
display = true
format = "dddd, dd MMMM"
locale = "en_US"
font-family = "Inter"
font-size = 20
font-weight = 400
color = "#bac3ff"
margin-top = -15

[LockScreen.Message]
display = true
position = "bottom-center"
align = "center"
text = "Press any key"
font-family = "Inter"
font-size = 12
font-weight = 400
display-icon = false
icon = ""
icon-size = 16
color = "#c6c5d0"
paint-icon = false
spacing = 0

[LoginScreen]
background = "star-chart.png"
use-background-color = false
background-color = "#121318"
blur = 24
brightness = -0.25
saturation = 0.0

[LoginScreen.LoginArea]
position = "center"
margin = -1

[LoginScreen.LoginArea.Avatar]
shape = "circle"
border-radius = 35
active-size = 120
inactive-size = 80
inactive-opacity = 0.35
active-border-size = 0
inactive-border-size = 0
active-border-color = "#46464f"
inactive-border-color = "#46464f"
always-active = false

[LoginScreen.LoginArea.Username]
font-family = "Inter"
font-size = 16
font-weight = 700
color = "#e3e1e9"
margin = 10

[LoginScreen.LoginArea.PasswordInput]
width = 260
height = 40
display-icon = false
font-family = "Inter"
font-size = 12
icon = "password.svg"
icon-size = 16
content-color = "#e3e1e9"
background-color = "#1f1f25"
background-opacity = 1.0
border-size = 2
border-color = "#46464f"
border-radius-left = 12
border-radius-right = 12
margin-top = 10
masked-character = "●"

[LoginScreen.LoginArea.LoginButton]
background-color = "#292a2f"
background-opacity = 1.0
active-background-color = "#bac3ff"
active-background-opacity = 1.0
icon = "arrow-right.svg"
icon-size = 18
content-color = "#bac3ff"
active-content-color = "#212c61"
border-size = 0
border-color = "#46464f"
border-radius-left = 12
border-radius-right = 12
margin-left = 5
show-text-if-no-password = true
hide-if-not-needed = false
font-family = "Inter"
font-size = 12
font-weight = 600

[LoginScreen.LoginArea.Spinner]
display-text = true
text = "Logging in"
font-family = "Inter"
font-weight = 600
font-size = 14
icon-size = 30
icon = "spinner.svg"
color = "#e3e1e9"
spacing = 5

[LoginScreen.LoginArea.WarningMessage]
font-family = "Inter"
font-size = 11
font-weight = 400
normal-color = "#e3e1e9"
warning-color = "#e5bad8"
error-color = "#ffb4ab"
margin-top = 10

[LoginScreen.MenuArea.Buttons]
margin-top = 0
margin-right = 0
margin-bottom = 100
margin-left = 0
size = 30
border-radius = 10
spacing = 20
font-family = "Inter"

[LoginScreen.MenuArea.Popups]
max-height = 230
item-height = 30
item-spacing = 2
padding = 5
display-scrollbar = false
margin = 5
background-color = "#292a2f"
background-opacity = 1.0
active-option-background-color = "#34343a"
active-option-background-opacity = 1.0
content-color = "#e3e1e9"
active-content-color = "#bac3ff"
font-family = "Inter"
border-size = 0
border-color = "#46464f"
font-size = 11
icon-size = 16

[LoginScreen.MenuArea.Session]
display = true
position = "bottom-center"
index = 0
popup-direction = "up"
popup-align = "center"
display-session-name = false
button-width = -1
popup-width = 200
background-color = "#bac3ff"
background-opacity = 0.0
active-background-opacity = 1.0
content-color = "#e3e1e9"
active-content-color = "#212c61"
border-size = 0
font-size = 10
icon-size = 16

[LoginScreen.MenuArea.Layout]
display = false
position = "bottom-center"
index = 0
popup-direction = "up"
popup-align = "center"
popup-width = 180
display-layout-name = false
background-color = "#bac3ff"
background-opacity = 0.0
active-background-opacity = 1.0
content-color = "#e3e1e9"
active-content-color = "#212c61"
border-size = 0
font-size = 10
icon = "language.svg"
icon-size = 16

[LoginScreen.MenuArea.Keyboard]
display = false
position = "bottom-center"
index = 0
background-color = "#bac3ff"
background-opacity = 0.0
active-background-opacity = 1.0
content-color = "#e3e1e9"
active-content-color = "#212c61"
border-size = 0
icon = "keyboard.svg"
icon-size = 16

[LoginScreen.MenuArea.Power]
display = true
position = "bottom-center"
index = 0
popup-direction = "up"
popup-align = "center"
popup-width = 100
background-color = "#bac3ff"
background-opacity = 0.0
active-background-opacity = 1.0
content-color = "#e3e1e9"
active-content-color = "#212c61"
border-size = 0
icon = "power.svg"
icon-size = 16

[LoginScreen.VirtualKeyboard]
scale = 1.0
position = "login"
start-hidden = true
background-color = "#292a2f"
background-opacity = 0.15
key-content-color = "#e3e1e9"
key-color = "#292a2f"
key-opacity = 1.0
key-active-background-color = "#34343a"
key-active-opacity = 1.0
selection-background-color = "#e3e1e9"
selection-content-color = "#121318"
primary-color = "#bac3ff"
border-size = 0
border-color = "#46464f"
restrict-input = "none"

[Tooltips]
enable = true
font-family = "Inter"
font-size = 11
content-color = "#e3e1e9"
background-color = "#292a2f"
background-opacity = 1.0
border-radius = 10
disable-user = false
disable-login-button = false
