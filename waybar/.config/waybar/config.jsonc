{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "backlight",
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "custom/notification"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "hyprland/window": {
        "max-length": 45,
        "separate-outputs": false
    },
    "clock": {
        "format": "  {:%a %d %b   %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  wired",
        "format-disconnected": "󰖪  offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "max-length": 24,
        "on-click": "kitty --class nmtui-float -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "  {device_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "tooltip-format-off": "Bluetooth off (right-click to turn on)",
        "tooltip-format": "{controller_alias}: on (right-click to turn off)"
    },
    "backlight": {
        "format": "  {percent}%",
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                ""
            ]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "swayosd-client --output-volume +5 --max-volume 100",
        "on-scroll-down": "swayosd-client --output-volume -5"
    },
    "cpu": {
        "format": "  {usage}%",
        "interval": 3,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 5,
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "  {temperatureC}°C",
        "critical-threshold": 85,
        "interval": 5
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "tray": {
        "spacing": 8,
        "icon-size": 15
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span rise='6000' size='small'></span>",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
