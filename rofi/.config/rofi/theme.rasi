/* Your launcher layout, colored from colors.rasi (generated by matugen) */
@import "~/.config/rofi/colors.rasi"

* {
    bg:      @surface;
    bg-alt:  @surface-container;
    fg:      @on-surface;
    muted:   @outline;
    accent:  @primary;

    background-color: transparent;
    text-color:       @fg;
    font: "Inter 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    14px;
    width:            620px;
    padding:          16px;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
}
prompt { text-color: @accent; padding: 0 10px 0 0; font: "JetBrainsMono Nerd Font 12"; }
entry  { placeholder: "Search…"; placeholder-color: @muted; }

listview { lines: 8; spacing: 4px; scrollbar: false; }

element { padding: 9px 12px; border-radius: 8px; spacing: 10px; }
element normal.normal    { text-color: @fg; }
element alternate.normal { text-color: @fg; }
element selected.normal  { background-color: @accent; text-color: @on-primary; }
element-icon { size: 24px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
